// Cloudflare Workers config: serves the static site built by Astro into ./dist.
// "name" must match the project name set in the Cloudflare dashboard.
{
  "name": "sabrichamtouri-com",
  "compatibility_date": "2026-10-27",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
