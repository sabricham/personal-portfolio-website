---
import { getProfile } from '../lib/content';

const profile = await getProfile();
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-line">
  <div
    class="mx-auto flex max-w-5xl flex-col gap-3 px-4 py-8 font-mono text-xs text-muted sm:flex-row sm:items-center sm:justify-between sm:px-6"
  >
    <p>
      © {year}
      {profile.name}
      {profile.vatNumber && <span> · VAT {profile.vatNumber}</span>}
    </p>
    <ul class="flex flex-wrap gap-4">
      <li><a class="hover:text-accent" href={`mailto:${profile.links.email}`}>Email</a></li>
      <li><a class="hover:text-accent" href={profile.links.linkedin} rel="me">LinkedIn</a></li>
      <li><a class="hover:text-accent" href={profile.links.github} rel="me">GitHub</a></li>
      <li><a class="hover:text-accent" href="/cv/">CV</a></li>
      <li><a class="hover:text-accent" href="/privacy/">Privacy</a></li>
    </ul>
  </div>
</footer>
