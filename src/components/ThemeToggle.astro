---
// Dark by default. The choice is saved in the browser and applied in Base.astro before paint.
---

<button
  type="button"
  data-theme-toggle
  class="grid size-9 place-items-center rounded-md border border-line text-muted transition-colors hover:border-accent hover:text-accent"
  aria-label="Switch to light theme"
  title="Toggle theme"
>
  <!-- sun: shown in dark mode -->
  <svg class="theme-icon-sun size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
  </svg>
  <!-- moon: shown in light mode -->
  <svg class="theme-icon-moon size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
    <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"></path>
  </svg>
</button>

<style>
  .theme-icon-moon {
    display: none;
  }
  :global(:root[data-theme='light']) .theme-icon-sun {
    display: none;
  }
  :global(:root[data-theme='light']) .theme-icon-moon {
    display: block;
  }
</style>

<script>
  const root = document.documentElement;

  function sync(button: HTMLButtonElement) {
    const light = root.dataset.theme === 'light';
    button.setAttribute('aria-label', light ? 'Switch to dark theme' : 'Switch to light theme');
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
    sync(button);
    button.addEventListener('click', () => {
      const next = root.dataset.theme === 'light' ? 'dark' : 'light';
      if (next === 'light') root.dataset.theme = 'light';
      else delete root.dataset.theme;
      try {
        localStorage.setItem('theme', next);
      } catch {}
      sync(button);
    });
  }
</script>
