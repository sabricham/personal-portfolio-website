---
import Chip from './Chip.astro';
import ProjectCover from './ProjectCover.astro';
import { formatYears, slugify, type Project } from '../lib/content';

interface Props {
  project: Project;
}
const { project } = Astro.props;
const { title, summary, technologies, period, nda, type, tags } = project.data;
---

<article
  class="group relative flex flex-col gap-4 rounded-xl border border-line bg-surface p-3 transition-colors hover:border-accent/60"
  data-project-card
  data-tags={tags.map(slugify).join(' ')}
>
  <ProjectCover project={project} />
  <div class="flex flex-1 flex-col gap-3 px-1 pb-1">
    <div class="flex items-center justify-between gap-2 font-mono text-[0.7rem] text-muted">
      <span>{formatYears(period.start, period.end)} · {type}</span>
      {nda && <span title="Details anonymized">NDA</span>}
    </div>
    <h3 class="text-lg leading-snug font-semibold">
      <a href={`/projects/${project.id}/`} class="after:absolute after:inset-0 group-hover:text-accent">
        {title}
      </a>
    </h3>
    <p class="text-sm leading-relaxed text-muted">{summary}</p>
    <ul class="mt-auto flex flex-wrap gap-1.5 pt-1" aria-label="Technologies">
      {
        technologies.slice(0, 5).map((t) => (
          <li>
            <Chip>{t}</Chip>
          </li>
        ))
      }
    </ul>
  </div>
</article>
