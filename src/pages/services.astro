---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import SectionLabel from '../components/SectionLabel.astro';
import ButtonLink from '../components/ButtonLink.astro';
import { getProfile, getProjects, getServices } from '../lib/content';

const profile = await getProfile();
const projects = await getProjects();
const services = await Promise.all(
  (await getServices()).map(async (s) => ({
    ...s,
    Content: (await render(s)).Content,
    projects: projects.filter((p) => p.data.services.some((ref) => ref.id === s.id)),
  })),
);
---

<Base title="Services" description="Freelance services: Yocto distributions and BSPs, HIL test systems, CI for embedded.">
  <section class="mx-auto max-w-3xl px-4 pt-16 sm:px-6">
    <SectionLabel>Services</SectionLabel>
    <h1 class="mt-3 font-serif text-4xl font-semibold">Services</h1>
    <p class="mt-4 text-lg leading-relaxed text-fg/85">
      I help teams ship embedded Linux products with confidence: from the distribution that runs on the device to the
      tests that check it on every change.
    </p>
    {
      !profile.availableForFreelance && (
        <p class="mt-4 font-mono text-sm text-muted">Currently not taking new freelance projects.</p>
      )
    }

    <div class="mt-12 space-y-6">
      {
        services.map((s, i) => (
          <section id={s.id} class="scroll-mt-20 rounded-xl border border-line bg-surface p-6 sm:p-8">
            <p class="font-mono text-xs text-muted">0{i + 1}</p>
            <h2 class="mt-2 text-2xl font-semibold">{s.data.title}</h2>
            <p class="mt-3 leading-relaxed text-fg/85">{s.data.summary}</p>
            <div class="prose mt-3">
              <s.Content />
            </div>
            {s.data.deliverables.length > 0 && (
              <ul class="mt-5 space-y-2 text-sm">
                {s.data.deliverables.map((d) => (
                  <li class="flex gap-3">
                    <span class="font-mono text-accent" aria-hidden="true">
                      →
                    </span>
                    {d}
                  </li>
                ))}
              </ul>
            )}
            {s.projects.length > 0 && (
              <p class="mt-6 border-t border-line pt-4 font-mono text-xs text-muted">
                Related work:{' '}
                {s.projects.map((p, j) => (
                  <>
                    {j > 0 && ', '}
                    <a href={`/projects/${p.id}/`} class="text-accent hover:underline">
                      {p.data.title}
                    </a>
                  </>
                ))}
              </p>
            )}
          </section>
        ))
      }
    </div>

    <div class="mt-12 flex flex-wrap gap-3">
      <ButtonLink href={`mailto:${profile.links.email}`} variant="primary">Discuss a project</ButtonLink>
      {profile.links.booking && <ButtonLink href={profile.links.booking}>Book a call</ButtonLink>}
    </div>
  </section>
</Base>
