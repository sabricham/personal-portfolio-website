---
import { getEntries, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Chip from '../../components/Chip.astro';
import ProjectCover from '../../components/ProjectCover.astro';
import { formatRange, getProjects, type Project } from '../../lib/content';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

interface Props {
  project: Project;
}
const { project } = Astro.props;
const { title, summary, role, period, type, nda, client, technologies, repoUrl, demoUrl } = project.data;
const { Content } = await render(project);
const services = await getEntries(project.data.services);
---

<Base title={title} description={summary}>
  <article class="mx-auto max-w-3xl px-4 pt-12 sm:px-6">
    <a href="/projects/" class="font-mono text-xs text-muted hover:text-accent">← All projects</a>

    <header class="mt-8">
      <p class="font-mono text-xs tracking-[0.18em] text-accent uppercase">{type}</p>
      <h1 class="mt-3 font-serif text-4xl font-semibold tracking-tight sm:text-5xl">{title}</h1>
      <p class="mt-4 text-lg leading-relaxed text-fg/85">{summary}</p>
      {
        nda && (
          <p class="mt-5 inline-flex items-center gap-2 rounded-full border border-accent/40 bg-accent-soft px-3 py-1 font-mono text-xs text-accent">
            <span aria-hidden="true">●</span> Details anonymized (NDA)
          </p>
        )
      }
    </header>

    <div class="mt-10">
      <ProjectCover project={project} large />
    </div>

    <dl class="mt-10 grid gap-x-8 gap-y-5 border-y border-line py-6 text-sm sm:grid-cols-2">
      <div>
        <dt class="font-mono text-[0.7rem] text-muted">Role</dt>
        <dd class="mt-1">{role}</dd>
      </div>
      <div>
        <dt class="font-mono text-[0.7rem] text-muted">Period</dt>
        <dd class="mt-1">{formatRange(period.start, period.end)}</dd>
      </div>
      {
        !nda && client && (
          <div>
            <dt class="font-mono text-[0.7rem] text-muted">Client</dt>
            <dd class="mt-1">{client}</dd>
          </div>
        )
      }
      <div class="sm:col-span-2">
        <dt class="font-mono text-[0.7rem] text-muted">Technologies</dt>
        <dd class="mt-2 flex flex-wrap gap-1.5">{technologies.map((t) => <Chip>{t}</Chip>)}</dd>
      </div>
      {
        !nda && (repoUrl || demoUrl) && (
          <div class="flex gap-4 font-mono text-xs sm:col-span-2">
            {repoUrl && (
              <a href={repoUrl} class="text-accent hover:underline">
                Source code ↗
              </a>
            )}
            {demoUrl && (
              <a href={demoUrl} class="text-accent hover:underline">
                Live demo ↗
              </a>
            )}
          </div>
        )
      }
    </dl>

    <div class="prose mt-4">
      <Content />
    </div>

    {
      services.length > 0 && (
        <aside class="mt-16 rounded-xl border border-line bg-surface p-6">
          <p class="font-mono text-xs text-muted">Related services</p>
          <ul class="mt-3 flex flex-wrap gap-x-6 gap-y-2">
            {services.map((s) => (
              <li>
                <a href={`/services/#${s.id}`} class="text-accent hover:underline">
                  {s.data.title} →
                </a>
              </li>
            ))}
          </ul>
        </aside>
      )
    }
  </article>
</Base>
