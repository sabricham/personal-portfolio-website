---
import Base from '../layouts/Base.astro';
import ButtonLink from '../components/ButtonLink.astro';
---

<Base title="Not found">
  <section class="mx-auto max-w-3xl px-4 pt-24 sm:px-6">
    <p class="font-mono text-sm text-muted">$ cat {Astro.url.pathname}</p>
    <p class="mt-2 font-mono text-sm text-accent">No such file or directory</p>
    <h1 class="mt-8 font-serif text-4xl font-semibold">Page not found</h1>
    <div class="mt-8 flex gap-3">
      <ButtonLink href="/" variant="primary">Home</ButtonLink>
      <ButtonLink href="/projects/">Projects</ButtonLink>
    </div>
  </section>
</Base>
