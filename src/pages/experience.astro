---
import { getEntries } from 'astro:content';
import Base from '../layouts/Base.astro';
import SectionLabel from '../components/SectionLabel.astro';
import SkillsTable from '../components/SkillsTable.astro';
import Chip from '../components/Chip.astro';
import ButtonLink from '../components/ButtonLink.astro';
import { formatRange, formatYears, getExperience, getProfile } from '../lib/content';

const profile = await getProfile();
const jobs = await Promise.all(
  (await getExperience()).map(async (job) => ({ ...job, projects: await getEntries(job.data.relatedProjects) })),
);
---

<Base title="Experience" description={`Work experience, skills and education of ${profile.name}.`}>
  <section class="mx-auto max-w-3xl px-4 pt-16 sm:px-6">
    <SectionLabel>Experience</SectionLabel>
    <div class="mt-3 flex flex-wrap items-end justify-between gap-4">
      <h1 class="font-serif text-4xl font-semibold">Experience</h1>
      <ButtonLink href="/cv/">Printable CV →</ButtonLink>
    </div>

    <!-- Timeline -->
    <ol class="mt-12 border-l border-line">
      {
        jobs.map((job) => (
          <li class="relative pb-12 pl-8 last:pb-0">
            <span
              class:list={[
                'absolute top-1.5 -left-[5px] size-[9px] rounded-full border-2 border-bg',
                job.data.end ? 'bg-muted' : 'bg-accent',
              ]}
              aria-hidden="true"
            />
            <p class="font-mono text-xs text-muted">{formatRange(job.data.start, job.data.end)}</p>
            <h2 class="mt-2 text-xl font-semibold">{job.data.position}</h2>
            <p class="mt-1 text-muted">
              {job.data.company} · {job.data.location}
            </p>
            <ul class="mt-4 list-disc space-y-2 pl-5 leading-relaxed text-fg/85 marker:text-accent">
              {job.data.highlights.map((h) => (
                <li>{h}</li>
              ))}
            </ul>
            {job.data.technologies.length > 0 && (
              <div class="mt-4 flex flex-wrap gap-1.5">
                {job.data.technologies.map((t) => (
                  <Chip>{t}</Chip>
                ))}
              </div>
            )}
            {job.projects.length > 0 && (
              <p class="mt-4 font-mono text-xs text-muted">
                Projects:{' '}
                {job.projects.map((p, i) => (
                  <>
                    {i > 0 && ', '}
                    <a href={`/projects/${p.id}/`} class="text-accent hover:underline">
                      {p.data.title}
                    </a>
                  </>
                ))}
              </p>
            )}
          </li>
        ))
      }
    </ol>
  </section>

  <section class="mx-auto mt-20 max-w-3xl px-4 sm:px-6">
    <SectionLabel>Skills</SectionLabel>
    <div class="mt-6"><SkillsTable /></div>
  </section>

  <section class="mx-auto mt-20 grid max-w-3xl gap-12 px-4 sm:grid-cols-2 sm:px-6">
    <div>
      <SectionLabel>Education</SectionLabel>
      <ul class="mt-6 space-y-5">
        {
          profile.education.map((e) => (
            <li>
              <p class="font-mono text-xs text-muted">{formatYears(e.start, e.end)}</p>
              <p class="mt-1 font-semibold">{e.degree}</p>
              <p class="text-muted">{e.school}</p>
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <SectionLabel>Languages</SectionLabel>
      <ul class="mt-6 space-y-3">
        {
          profile.languages.map((l) => (
            <li class="flex justify-between gap-4 border-b border-line pb-3">
              <span>{l.name}</span>
              <span class="text-muted">{l.level}</span>
            </li>
          ))
        }
      </ul>
      {
        profile.certifications.length > 0 && (
          <>
            <div class="mt-12">
              <SectionLabel>Certifications</SectionLabel>
            </div>
            <ul class="mt-6 space-y-3">
              {profile.certifications.map((c) => (
                <li>
                  <p class="font-semibold">{c.name}</p>
                  <p class="text-muted">
                    {c.issuer} · {c.year}
                  </p>
                </li>
              ))}
            </ul>
          </>
        )
      }
    </div>
  </section>
</Base>
